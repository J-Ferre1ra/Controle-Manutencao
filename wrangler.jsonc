{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-manutencao-neoenergia",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "controle-ordens",
      "database_id": "50540b3c-abbd-4c3c-8397-bbf991c0f629",
      "migrations_dir": "drizzle"
    }
  ]
}
