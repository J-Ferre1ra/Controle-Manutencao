{
  "name": "controle-manutencao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:db:create": "wrangler d1 create controle-ordens-neoenergia",
    "cf:db:migrate:local": "wrangler d1 migrations apply controle-ordens-neoenergia --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply controle-ordens-neoenergia --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.39.0"
  }
}
